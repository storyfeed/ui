{
    "name": "storyfeed/ui",
    "description": "Renderers for Storyfeed activity feeds: Blade, Vue/Inertia and React/Inertia component kits.",
    "keywords": [
        "laravel",
        "storyfeed",
        "activity-feed",
        "vue",
        "inertia",
        "blade"
    ],
    "homepage": "https://github.com/storyfeed/ui",
    "license": "MIT",
    "authors": [
        {
            "name": "Jasper Tey",
            "email": "jasper@teylabs.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0",
        "league/commonmark": "^2.7",
        "storyfeed/storyfeed": "^0.12.0",
        "symfony/html-sanitizer": "^7.3 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^4.0 || ^5.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Storyfeed\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Storyfeed\\Ui\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Storyfeed\\Ui\\UiServiceProvider"
            ]
        }
    }
}
